{
  "info": {
    "name": "Kombo REST API",
    "description": "Example requests for every operation of the Kombo REST API. Set the baseUrl variable to the address of the backend (https://localhost by default). The backend uses a self-signed certificate: disable \"SSL certificate verification\" in the Postman settings. Log in first with \"Auth > Log in\": Postman keeps the httpOnly session cookie and sends it in the next requests. The sample users are customer@kombo.com / customer and employee@kombo.com / employee; the administrator is admin@kombo.com with the password configured in KOMBO_ADMIN_PASSWORD_HASH.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost"
    },
    {
      "key": "email",
      "value": "customer@kombo.com"
    },
    {
      "key": "password",
      "value": "customer"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Login flow: log in, check the logged in user and log out. The JWT travels in the httpOnly cookie kombo_token.",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Checks the email and password. Answers 200 with the user and the Set-Cookie header with the session JWT (httpOnly, Secure, SameSite=Strict), or 401 with wrong credentials. Change the email and password variables to log in with another user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get the logged in user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the logged in user (200), or 401 without a valid session cookie."
          },
          "response": []
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the session cookie (204)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get products (first page)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Returns the first page of active products of the menu (10 per page by default). The response has the products in `content` and the page information in `page`."
          },
          "response": []
        },
        {
          "name": "Get products by page and size",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=0&size=2&sort=name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "2"
                },
                {
                  "key": "sort",
                  "value": "name"
                }
              ]
            },
            "description": "Returns a page of active products. `page` starts at 0, `size` is the number of products per page and `sort` is the property used to sort them."
          },
          "response": []
        },
        {
          "name": "Get products by category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?category=Burgers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Burgers"
                }
              ]
            },
            "description": "Returns the active products of a category (case insensitive), paginated."
          },
          "response": []
        },
        {
          "name": "Get product detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "1"
              ]
            },
            "description": "Returns the detail of a product or combo: its ingredients with the quantity used and, for a combo, its products."
          },
          "response": []
        },
        {
          "name": "Get product image",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/1/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "1",
                "image"
              ]
            },
            "description": "Returns the picture of the product as binary content, with its type (for example image/jpeg) in the Content-Type header. Returns 404 if the product does not exist or has no picture."
          },
          "response": []
        },
        {
          "name": "Get product that does not exist (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "999999"
              ]
            },
            "description": "Example of error: returns 404 Not Found in ProblemDetail format."
          },
          "response": []
        },
        {
          "name": "Get product with invalid id (400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "abc"
              ]
            },
            "description": "Example of error: returns 400 Bad Request in ProblemDetail format."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "Each user can only read their own data; the administrator can read any user.",
      "item": [
        {
          "name": "Get users (administrator)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "Paginated list of users. Only the administrator: 401 without login and 403 with another role."
          },
          "response": []
        },
        {
          "name": "Get a user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Profile of a user. 200 for the user themselves or the administrator, 403 for another user, 401 without login."
          },
          "response": []
        },
        {
          "name": "Get the orders of a user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}",
                "orders"
              ]
            },
            "description": "Order history of a user, the most recent first (paginated). 200 for the user themselves or the administrator, 403 for another user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get an order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Detail of an order. Employees and the administrator can read any order; a customer only their own (403 otherwise). 404 if it does not exist."
          },
          "response": []
        }
      ]
    }
  ]
}
