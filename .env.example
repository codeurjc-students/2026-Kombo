# Copy this file to .env (same folder) and change the values. .env is never committed.
# It is read by the backend (./mvnw spring-boot:run, from backend/) and by docker compose.

# MySQL database
KOMBO_DB_PASSWORD=change-me

# Only administrator: email and BCrypt hash of the password (never the plain password).
# Generate the hash with:  docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" "your-password" | tr -d ':\n'
# docker compose reads "$" as the start of a variable: write every "$" of the hash as "$$"
# (the backend undoes this escape, so the same file works for both).
# Example hash of "admin" (only for local development):
KOMBO_ADMIN_EMAIL=admin@kombo.com
KOMBO_ADMIN_PASSWORD_HASH=$$2b$$10$$GfBhP7nNxexOinn7O4x0w.GfVoH.WobAAFbuerLEUfjiiP43QFFd6

# Key used to sign the session JWT: at least 32 random characters, for example: openssl rand -base64 48
KOMBO_JWT_SECRET=change-me-with-at-least-32-random-characters

# HTTPS keystore (see "HTTPS certificate" in docs/development-guide.md)
KOMBO_SSL_KEY_STORE_PASSWORD=change-me
